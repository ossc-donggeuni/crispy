{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "summary",
    "tasks",
    "expectedModifiedFiles",
    "expectedCreatedFiles",
    "expectedDeletedOrRemovedTargets",
    "referenceFiles",
    "targetNodes",
    "preImplementationChecks",
    "postImplementationComparisonCriteria"
  ],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "description",
          "order",
          "directTargets",
          "createdTargets",
          "deletedTargets",
          "referenceTargets",
          "possibleImpactTargets"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "order": { "type": "integer", "minimum": 1 },
          "directTargets": { "$ref": "#/$defs/pathList" },
          "createdTargets": { "$ref": "#/$defs/pathList" },
          "deletedTargets": { "$ref": "#/$defs/pathList" },
          "referenceTargets": { "$ref": "#/$defs/pathList" },
          "possibleImpactTargets": { "$ref": "#/$defs/pathList" }
        }
      }
    },
    "expectedModifiedFiles": { "$ref": "#/$defs/fileItems" },
    "expectedCreatedFiles": { "$ref": "#/$defs/fileItems" },
    "expectedDeletedOrRemovedTargets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "codeNodeId", "description", "isFileDeletion", "taskIds"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "codeNodeId": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "isFileDeletion": { "type": "boolean" },
          "taskIds": { "$ref": "#/$defs/taskIdList" }
        }
      }
    },
    "referenceFiles": { "$ref": "#/$defs/fileItems" },
    "targetNodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relation",
          "changes",
          "matchStatus",
          "path",
          "codeNodeId",
          "taskIds",
          "isAdditionalCandidate",
          "isFileDeletion",
          "originalTargetText",
          "note"
        ],
        "properties": {
          "relation": { "enum": ["direct", "possible-impact", "reference"] },
          "changes": {
            "type": "array",
            "items": { "enum": ["create", "modify", "delete"] }
          },
          "matchStatus": { "enum": ["resolved", "scoped", "unresolved"] },
          "path": { "type": ["string", "null"] },
          "codeNodeId": { "type": "string", "minLength": 1 },
          "taskIds": { "$ref": "#/$defs/taskIdList" },
          "isAdditionalCandidate": { "type": "boolean" },
          "isFileDeletion": { "type": "boolean" },
          "originalTargetText": { "type": ["string", "null"] },
          "note": { "type": ["string", "null"] }
        }
      }
    },
    "preImplementationChecks": { "$ref": "#/$defs/stringList" },
    "postImplementationComparisonCriteria": { "$ref": "#/$defs/stringList" }
  },
  "$defs": {
    "pathList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "taskIdList": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "stringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "fileItems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "codeNodeId", "reason", "taskIds"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "codeNodeId": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "taskIds": { "$ref": "#/$defs/taskIdList" }
        }
      }
    }
  }
}
